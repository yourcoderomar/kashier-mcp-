# Copy to .env and fill in. Never commit .env.

# mock | test | live  (default: test). mock needs no keys.
KASHIER_MODE=test

# Dashboard > Integrations > Secret keys (sent as the raw Authorization header)
KASHIER_SECRET_KEY=your-test-secret-key

# Dashboard > Integrations > Payment API keys (sent as the api-key header when creating sessions)
KASHIER_API_KEY=your-test-payment-api-key

# Shown under your username in the dashboard top bar
KASHIER_MERCHANT_ID=MID-00000-000

# Where Kashier sends the customer after paying (any URL works for testing)
KASHIER_MERCHANT_REDIRECT=https://example.com/thanks

# Required to start in live mode — live refunds move real money.
# KASHIER_ALLOW_LIVE=true
